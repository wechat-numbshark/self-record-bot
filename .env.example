# ====== 飞书自建应用 ======
# 开放平台 → 你的应用 → 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OWNER_ID=

# ====== 飞书文件夹（从浏览器地址栏复制 folder token）======
# 多维表格存放文件夹：.../drive/folder/<这里>
BITABLE_FOLDER_TOKEN=
# 云文档存放文件夹：.../drive/folder/<这里>
DOCX_FOLDER_TOKEN=

# ====== OpenRouter ======
OPENROUTER_API_KEY=
# 单条记录（摘要 + 即时回复 + 是否需要回复判断）用便宜模型
MODEL_SINGLE=z-ai/glm-5.1
# 每日 / 周 / 月深度整理用 GLM-4.6（中文强、性价比高）
MODEL_SUMMARY=z-ai/glm-4.6
# 图片理解（含视觉）用 GLM-4.6V（多模态）
MODEL_VISION=z-ai/glm-4.6v

# ====== 行为配置 ======
# 回复与 AI 输出语言：zh / en / ja
BOT_LANGUAGE=zh
# 每日整理时间（cron，本机时区）。默认 23:00
CRON_DAILY=0 23 * * *
# 23 点后仍有新消息时的补整理时间。默认次日 02:00
CRON_DAILY_LATE=0 2 * * *
# 周整理：每周日 22:00
CRON_WEEKLY=0 22 * * 0
# 月整理：每月 1 日 03:00（整理上个月）
CRON_MONTHLY=0 3 1 * *
# 时区
TZ=Asia/Shanghai

# 仅在「明显提问 / 情绪低落」时即时回复（true=由 AI 判断后回复；false=从不即时回复）
ENABLE_INSTANT_REPLY=true

# 语音识别：飞书 file_recognize 要求 pcm/16k。需要本机安装 ffmpeg 做转码。
# ffmpeg 可执行文件路径（已加入 PATH 时填 ffmpeg 即可）
FFMPEG_PATH=ffmpeg

# 可选：本机 Claude CLI 整理后端；默认使用 OpenRouter
SUMMARY_BACKEND=openrouter
